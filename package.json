{
  "name": "yttracker",
  "version": "4.0.0",
  "author": "Thomas Couchoud <zerderr@gmail.com> (https://github.com/Rakambda/)",
  "description": "This extension will track your time on YouTube",
  "homepage": "https://github.com/RakambdaOrg/YTTracker/blob/main/README.md",
  "bugs": "https://github.com/RakambdaOrg/YTTracker/issues",
  "repository": "github:RakambdaOrg/YTTracker",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:beta": "wxt build --mode beta",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:beta": "wxt zip --mode beta",
    "compile": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm compile && pnpm lint && pnpm test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "chart.js": "4.6.1"
  }
}
